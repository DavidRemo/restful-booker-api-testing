    {
      "name": "Update booking (PUT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();\r\n\r\npm.test(\"Status is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Lastname was replaced with the PUT value\", function () {\r\n    pm.expect(body.lastname).to.eql(\"Cook\");\r\n});\r\n\r\npm.test(\"Full booking came back\", function () {\r\n    pm.expect(body).to.have.all.keys(\r\n        \"firstname\", \"lastname\", \"totalprice\",\r\n        \"depositpaid\", \"bookingdates\", \"additionalneeds\"\r\n    );\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "token={{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstname\": \"David\",\r\n    \"lastname\": \"Cook\",\r\n    \"totalprice\": 300,\r\n    \"depositpaid\": false,\r\n    \"bookingdates\":{\r\n        \"checkin\": \"2026-12-01\",\r\n        \"checkout\": \"2026-12-07\"\r\n    },\r\n    \"additionalneeds\": \"Dinner\"\r\n}",
          "options": {
