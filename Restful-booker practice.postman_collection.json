    {
      "name": "Get one booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();\r\n\r\npm.test(\"Status is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Name is the one I created\", function () {\r\n    pm.expect(body.firstname).to.eql(\"David\");\r\n    pm.expect(body.lastname).to.eql(\"Remo\");\r\n});"
            ]
          }
        }
      ],
