    {
      "name": "Create booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"bookingid is a number\", function () {\r\n    pm.expect(body.bookingid).to.be.a('number');\r\n});\r\n\r\npm.test(\"Saved firstname matches what I sent\", function () {\r\n    pm.expect(body.booking.firstname).to.eql(\"David\");\r\n});\r\n\r\npm.test(\"totalprice is a number\", function (){\r\n    pm.expect(body.booking.totalprice).to.be.a('number');\r\n});\r\n\r\npm.test(\"depositpaid is a boolean\", function () {\r\n    pm.expect(body.booking.depositpaid).to.be.a('boolean');\r\n});\r\n\r\npm.collectionVariables.set(\"bookingId\", body.bookingid);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstname\": \"David\",\r\n    \"lastname\": \"Remo\",\r\n    \"totalprice\": 250,\r\n    \"depositpaid\": true,\r\n    \"bookingdates\":{\r\n        \"checkin\": \"2026-12-01\",\r\n        \"checkout\": \"2026-12-05\"\r\n    },\r\n    \"additionalneeds\": \"Breakfast\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
